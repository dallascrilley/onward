#!/bin/bash
# Stub claude binary for fast eval testing
# Uses STUB_EXPECTED_DECISION env var from harness to return correct decision
# Uses STUB_V2_FIELDS env var (JSON) to return scenario-specific v2 metadata

# Read stdin (required for compatibility but content is ignored in stub mode)
cat > /dev/null

# Use the expected decision from the harness (passed via env var)
# This makes the stub deterministic and always correct for testing harness infrastructure
case "$STUB_EXPECTED_DECISION" in
    true)
        SHOULD_CONTINUE="true"
        REASONING="Stub: Expected continuation (STUB_EXPECTED_DECISION=true)"
        # Default v2 values for continuation
        DEFAULT_CONFIDENCE="0.92"
        DEFAULT_CATEGORY="explicit_continuation"
        DEFAULT_SIGNALS='["explicit_next_steps","incomplete_implementation"]'
        DEFAULT_RISK="low"
        ;;
    false)
        SHOULD_CONTINUE="false"
        REASONING="Stub: Expected stop (STUB_EXPECTED_DECISION=false)"
        # Default v2 values for stop
        DEFAULT_CONFIDENCE="0.88"
        DEFAULT_CATEGORY="task_completion"
        DEFAULT_SIGNALS='["explicit_completion"]'
        DEFAULT_RISK="low"
        ;;
    *)
        echo "ERROR: STUB_EXPECTED_DECISION must be 'true' or 'false', got '${STUB_EXPECTED_DECISION:-<unset>}'." >&2
        exit 2
        ;;
esac

# Override v2 fields from STUB_V2_FIELDS if provided (JSON object)
# Supports: confidence, decision_category, risk_level, signals
if [ -n "$STUB_V2_FIELDS" ]; then
    # Extract values from JSON, using defaults if not specified
    CONFIDENCE=$(echo "$STUB_V2_FIELDS" | jq -r '.confidence // empty')
    CATEGORY=$(echo "$STUB_V2_FIELDS" | jq -r '.decision_category // empty')
    RISK=$(echo "$STUB_V2_FIELDS" | jq -r '.risk_level // empty')
    SIGNALS_RAW=$(echo "$STUB_V2_FIELDS" | jq -c '.signals // empty')

    # Use extracted values or fall back to defaults
    [ -z "$CONFIDENCE" ] && CONFIDENCE="$DEFAULT_CONFIDENCE"
    [ -z "$CATEGORY" ] && CATEGORY="$DEFAULT_CATEGORY"
    [ -z "$RISK" ] && RISK="$DEFAULT_RISK"
    [ -z "$SIGNALS_RAW" ] || [ "$SIGNALS_RAW" = "null" ] && SIGNALS_RAW="$DEFAULT_SIGNALS"
    SIGNALS="$SIGNALS_RAW"
else
    # No v2 overrides, use defaults
    CONFIDENCE="$DEFAULT_CONFIDENCE"
    CATEGORY="$DEFAULT_CATEGORY"
    SIGNALS="$DEFAULT_SIGNALS"
    RISK="$DEFAULT_RISK"
fi

REASONS='["Stub mode: test infrastructure validation"]'

# Output in streaming JSON format that the hook expects
# The hook parses: jq '.[] | select(.type == "result") | .structured_output'
# v2 schema includes: confidence, decision_category, signals, risk_level, reasons
cat << EOF
[{"type":"result","structured_output":{"should_continue":$SHOULD_CONTINUE,"reasoning":"$REASONING","confidence":$CONFIDENCE,"decision_category":"$CATEGORY","signals":$SIGNALS,"risk_level":"$RISK","reasons":$REASONS}}]
EOF
